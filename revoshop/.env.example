# Copy this file to .env.local and fill in the values.

# Base URL of the Module 2 Flask API. Must be prefixed with NEXT_PUBLIC_
# so it is readable in the browser (client components).
NEXT_PUBLIC_API_BASE_URL=https://your-api-host.example.com

# Server-only secret for privileged API calls (no NEXT_PUBLIC_ prefix,
# so it stays on the server and is never shipped to the browser).
API_SECRET_KEY=your-secret-key

# --- Playwright E2E (optional; only needed to run the admin CRUD tests) ---
# Credentials for an existing Admin account. Kept out of the test source so no
# real credentials are committed. Set these in .env.local (git-ignored).
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=your-admin-password
